{
  "name": "markdown-preview-fold",
  "displayName": "Markdown Preview Fold",
  "description": "Collapse and expand heading sections in the built-in Markdown preview.",
  "version": "0.1.0",
  "publisher": "antonburduzha",
  "license": "MIT",
  "author": {
    "name": "Anton Burduzha"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AntonBurduzha/markdown-preview-fold"
  },
  "bugs": {
    "url": "https://github.com/AntonBurduzha/markdown-preview-fold/issues"
  },
  "homepage": "https://github.com/AntonBurduzha/markdown-preview-fold#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "fold",
    "collapse",
    "headings",
    "outline"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./dist/preview.js"
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
