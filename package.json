{
  "name": "markdown-preview-fold",
  "displayName": "Markdown Preview Fold",
  "description": "Collapse and expand heading sections in the built-in Markdown preview.",
  "version": "0.1.0",
  "publisher": "antonburduzha",
  "license": "MIT",
  "author": {
    "name": "Anton Burduzha"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AntonBurduzha/markdown-preview-fold"
  },
  "bugs": {
    "url": "https://github.com/AntonBurduzha/markdown-preview-fold/issues"
  },
  "homepage": "https://github.com/AntonBurduzha/markdown-preview-fold#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "fold",
    "collapse",
    "headings",
    "outline"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./dist/preview.js"
    ],
    "markdown.previewStyles": [
      "./media/preview.css"
    ],
    "commands": [
      {
        "command": "markdownPreviewFold.collapseAll",
        "title": "Collapse All Sections",
        "category": "Markdown Preview Fold",
        "icon": "$(collapse-all)"
      },
      {
        "command": "markdownPreviewFold.expandAll",
        "title": "Expand All Sections",
        "category": "Markdown Preview Fold",
        "icon": "$(expand-all)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownPreviewFold.collapseAll",
          "when": "activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'",
          "group": "navigation@10"
        },
        {
          "command": "markdownPreviewFold.expandAll",
          "when": "activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'",
          "group": "navigation@11"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownPreviewFold.collapseAll",
          "when": "activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'"
        },
        {
          "command": "markdownPreviewFold.expandAll",
          "when": "activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownPreviewFold.collapseAll",
        "key": "ctrl+k ctrl+0",
        "mac": "cmd+k cmd+0",
        "when": "activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'"
      },
      {
        "command": "markdownPreviewFold.expandAll",
        "key": "ctrl+k ctrl+j",
        "mac": "cmd+k cmd+j",
        "when": "activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test:integration": "node esbuild.mjs --tests && vscode-test",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "markdown-it": "15.0.3",
    "morphdom": "2.7.8",
    "ovsx": "1.4.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
